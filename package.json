{
  "name": "testhive",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test -- --passWithNoTests",
    "db:generate": "bun --filter @testhive/db db:generate",
    "db:migrate": "bun --filter @testhive/db db:migrate",
    "pool:build": "tsx scripts/build-pool.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo:site": "tsx scripts/serve-demo-site.ts",
    "dev:all": "powershell -ExecutionPolicy Bypass -File ./start-all.ps1"
  },
  "dependencies": {
    "@testhive/contracts": "workspace:*",
    "@testhive/db": "workspace:*",
    "@testhive/llm": "workspace:*",
    "@testhive/personas": "workspace:*",
    "@testhive/graph": "workspace:*",
    "@testhive/engine": "workspace:*",
    "@testhive/analytics": "workspace:*",
    "@testhive/report": "workspace:*",
    "@testhive/config": "workspace:*"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "vitest": "^2.1.3",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "dependency-cruiser": "^16.4.2",
    "@types/node": "^20.16.11",
    "dotenv": "^16.4.5"
  },
  "packageManager": "bun@1.3.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
